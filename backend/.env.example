# Copy these into your host's environment settings (Render dashboard). Not read automatically.
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=your-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
DATABASE_URL=postgres://...

# WhatsApp via Twilio (leave blank to only log messages)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_COUNTRY_CODE=91

# Pre-approved template id; required on Twilio trial accounts, leave blank for free text
TWILIO_CONTENT_SID=
