server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # React Router handles the paths, so unknown URLs fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
